---
import Base from '../layouts/Base.astro';
import ProjectTile from '../components/ProjectTile.astro';
import { rows } from '../data/projects';
---
<Base>
  <header class="site-header">
    <a class="wordmark" href="/">BASSALT</a>
    <nav>
      <a href="#work">Work</a>
      <a href="#about">About</a>
      <a href="#contact">Contact</a>
    </nav>
  </header>

  <main>
    <section id="work" class="grid" aria-label="Selected work">
      {rows.map((row) => (
        <div class="row">
          {row.map((tile) => <ProjectTile {...tile} />)}
        </div>
      ))}
    </section>

    <section id="about" class="about">
      <p>Bassalt is a creative agency. We build brands on solid ground: identity, packaging and motion with a sense of weight.</p>
    </section>
  </main>

  <footer id="contact" class="site-footer">
    <h2 class="cta">Let’s make something heavy.</h2>
    <a href="mailto:hello@bassalt.studio">hello@bassalt.studio →</a>
    <div class="footer-bar">
      <span>© 2026 Bassalt</span>
      <span class="footer-links">
        <a href="#">Instagram</a><a href="#">Behance</a><a href="#">LinkedIn</a>
      </span>
    </div>
  </footer>
</Base>

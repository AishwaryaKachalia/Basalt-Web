---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProjectTile from '../components/ProjectTile.astro';
import { rows } from '../data/projects';
---
<Base>
  <Header />
  <main>
    <section id="work" class="grid" aria-label="Selected work">
      {rows.map((row) => (
        <div class="row">
          {row.map((tile) => <ProjectTile {...tile} />)}
        </div>
      ))}
    </section>
  </main>
  <Footer />
</Base>

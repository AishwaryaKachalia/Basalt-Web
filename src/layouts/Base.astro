---
import '@fontsource-variable/montserrat';
import '../styles/global.css';

interface Props { title?: string; description?: string }
const { title = 'Bassalt — The Cornerstone of Taste', description = 'Bassalt is a creative agency for brands built on a strong foundation.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preload" href="/fonts/Coconat-Bold.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <slot />
  </body>
</html>
